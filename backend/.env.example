# Backend configuration (export these in your shell; never commit a real key).
# Hybrid extraction runs automatically when a key is present; otherwise rules fallback mode.
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# EXTRACTION_MODE=hybrid          # or "rules" to force deterministic mode
# LLM_TIMEOUT_SECONDS=8
# LLM_BATCH_DEADLINE_SECONDS=3.5  # wall-clock LLM budget per simulate; stragglers use rules fallback
# LLM_CONCURRENCY=12
# SEWERSENSE_DATA_DIR=./data
# CORS_ORIGINS=http://localhost:5173
