# Copy to .env and fill in. SewerSense live-data keys (never commit the real .env).
# The demo works WITHOUT any of these. They only enable the "Fetch live data" button.
# After editing, restart the backend.

# --- Tavily (web/news search) -------------------------------------------------------------
# Get a key at https://app.tavily.com  (looks like tvly-...)
TAVILY_API_KEY=

# --- Apify (Actor-based scraping) ---------------------------------------------------------
# Token: https://console.apify.com/settings/integrations  (looks like apify_api_...)
APIFY_API_TOKEN=
# Which Actor to run. Default below is Apify's official Google Search scraper; change freely.
APIFY_ACTOR_ID=apify~google-search-scraper
# JSON input passed to the Actor (single line). Adjust to your chosen Actor's input schema.
APIFY_ACTOR_INPUT='{"queries": "Hyderabad sewage overflow\nHyderabad open manhole\nHyderabad drainage overflow\nKukatpally sewage", "resultsPerPage": 10, "maxPagesPerQuery": 1, "countryCode": "in"}'
# For SERP-style Actors each dataset item holds a list of results; this flattens it. Leave empty otherwise.
APIFY_UNWIND=organicResults

# --- Optional tuning (defaults are fine) ---------------------------------------------------
# TAVILY_QUERIES=Hyderabad sewage overflow|Hyderabad open manhole|Kukatpally sewage
# TAVILY_MAX_RESULTS=5
# TAVILY_TIME_RANGE=month
# APIFY_SOURCE_TYPE=social
# APIFY_MAX_ITEMS=50
# APIFY_TIMEOUT_SECONDS=120
