# Optional overrides for the command center (copy to .env.local).
# API base path; the Vite dev server proxies /api to http://localhost:8000.
# VITE_API_BASE=/api
# Basemap: defaults to Esri Dark Gray Canvas (keyless). CARTO dark tiles now require an API key.
# VITE_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
